# gsa_fcp_toolkit directory overrides.
# Copy to .env (or export in your shell) to relocate the working directories
# without touching code. Unset values fall back to <project-root>/data etc.
GSA_DATA_DIR=
GSA_TEMPLATE_DIR=
GSA_OUTPUT_DIR=

# Company identity used in the Word documents. Unset values fall back to
# [BRACKETED] placeholders, which render in red bold as manual entries in
# the generated documents — set these to brand the output.
GSA_COMPANY_NAME=
GSA_COMPANY_LOCATION=
GSA_COMPANY_POC=
GSA_PAYMENT_TERMS=
