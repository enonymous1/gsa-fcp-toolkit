__pycache__/
*.pyc
.venv/
.env
*.egg-info/
# Generated dirs live at the repo root only, so anchor them: a bare "data/"
# also matches src/gsa_fcp_toolkit/data/ (the DataHandler subpackage) and
# silently keeps real source out of git -- that is what broke CI.
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Working data and generated outputs (never committed: real business data).
# Anchored to the repo root (see above).
/data/
/output/
*.log
*.docx

# Generated workbooks anywhere except the two shipped public GSA templates
# in templates/ (dummy example rows only, no real pricing data).
*.xlsx
!templates/FCP_Services_Plus_File.xlsx
!templates/FCP_Services_Plus_File_v-1.1-20260128.xlsx
